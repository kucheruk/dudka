#!/bin/sh
# Install the current Dudka terminal client and engine without system packages.
set -eu

version='@VERSION@'
expected_sha256='@ARCHIVE_SHA256@'
default_url="https://github.com/kucheruk/dudka/releases/download/v${version}/dudka-linux-amd64.tar.gz"
archive_url="${DUDKA_ARCHIVE_URL:-$default_url}"
install_dir="${DUDKA_INSTALL_DIR:-${HOME:?HOME is not set}/.local/bin}"

fail() {
  echo "Не удалось установить Дудку: $*" >&2
  exit 1
}

[ "$(uname -s)" = "Linux" ] || fail "нужен Linux"
case "$(uname -m)" in
  x86_64|amd64) ;;
  *) fail "пока поддерживается amd64" ;;
esac
command -v curl >/dev/null 2>&1 || fail "не найден curl"
command -v tar >/dev/null 2>&1 || fail "не найден tar"
command -v sha256sum >/dev/null 2>&1 || fail "не найден sha256sum"

work="$(mktemp -d "${TMPDIR:-/tmp}/dudka-install.XXXXXX")"
trap 'rm -rf "$work"' EXIT HUP INT TERM
archive="$work/dudka-linux-amd64.tar.gz"

echo "Скачиваю терминальную Дудку ${version}…"
curl -fL --retry 3 --connect-timeout 15 -o "$archive" "$archive_url"
printf '%s  %s\n' "$expected_sha256" "$archive" | sha256sum -c - >/dev/null ||
  fail "контрольная сумма архива не совпала"
tar -tzf "$archive" | grep -qx 'dudka-linux-amd64/dudka' ||
  fail "в архиве нет клиента dudka"
tar -tzf "$archive" | grep -qx 'dudka-linux-amd64/dudkad' ||
  fail "в архиве нет движка dudkad"

if [ "${DUDKA_INSTALL_DRY_RUN:-0}" = "1" ]; then
  echo "Архив Дудки ${version} проверен."
  exit 0
fi

configure_ufw() {
  [ "${DUDKA_SKIP_FIREWALL:-0}" != "1" ] || return 0
  [ -r /etc/ufw/ufw.conf ] || return 0
  grep -Eq '^[[:space:]]*ENABLED=yes' /etc/ufw/ufw.conf || return 0
  command -v ufw >/dev/null 2>&1 || return 0
  command -v ip >/dev/null 2>&1 ||
    fail "UFW включён, но не найден ip; задайте локальную сеть через DUDKA_LAN_CIDR"

  lan_cidr="${DUDKA_LAN_CIDR:-}"
  if [ -z "$lan_cidr" ]; then
    default_iface="$(ip -4 route show default | awk 'NR == 1 {for (i=1;i<=NF;i++) if ($i=="dev") {print $(i+1); exit}}')"
    [ -n "$default_iface" ] ||
      fail "UFW включён, но не удалось определить сетевой интерфейс"
    lan_cidr="$(ip -4 route show dev "$default_iface" scope link |
      awk '$1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\/[0-9]+$/ && $1 !~ /^169\.254\./ {print $1; exit}')"
  fi
  case "$lan_cidr" in
    10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) ;;
    *) fail "не удалось безопасно определить приватную LAN-подсеть: ${lan_cidr:-пусто}" ;;
  esac

  echo "UFW включён. Дудке нужны 41777/tcp+udp только внутри ${lan_cidr}."
  if [ "$(id -u)" -eq 0 ]; then
    ufw allow proto udp from "$lan_cidr" to any port 41777 comment 'dudka:discovery'
    ufw allow proto tcp from "$lan_cidr" to any port 41777 comment 'dudka:peer'
  else
    command -v sudo >/dev/null 2>&1 ||
      fail "нужен sudo для двух локальных UFW-правил; файлы ещё не установлены"
    echo "Сейчас sudo спросит пароль один раз; системные пакеты устанавливаться не будут."
    sudo ufw allow proto udp from "$lan_cidr" to any port 41777 comment 'dudka:discovery' ||
      fail "не получены права для локального UDP-правила; файлы ещё не установлены"
    sudo ufw allow proto tcp from "$lan_cidr" to any port 41777 comment 'dudka:peer' ||
      fail "не получены права для локального TCP-правила; файлы ещё не установлены"
  fi
}

configure_ufw

tar -xzf "$archive" -C "$work"
mkdir -p "$install_dir"
install -m 0755 "$work/dudka-linux-amd64/dudka" "$install_dir/dudka"
install -m 0755 "$work/dudka-linux-amd64/dudkad" "$install_dir/dudkad"

echo "Готово: $install_dir/dudka"
case ":${PATH:-}:" in
  *":$install_dir:"*) echo "Запуск: dudka" ;;
  *) echo "Запуск: $install_dir/dudka"
     echo "Чтобы команда dudka была доступна всегда, добавьте $install_dir в PATH." ;;
esac
